{
    "name": "djaiss/monica",
    "type": "project",
    "description": "Monica is a personal CRM.",
    "keywords": [
        "prm",
        "crm",
        "social"
    ],
    "license": "AGPL",
    "require": {
        "php": "^8.4",
        "ext-bcmath": "*",
        "ext-redis": "*",
        "asbiin/laravel-webauthn": "^5.0",
        "bacon/bacon-qr-code": "^3.0",
        "creativeorange/gravatar": "^1.0",
        "erusev/parsedown": "^1.7",
        "giggsey/libphonenumber-for-php": "^8.9",
        "guzzlehttp/guzzle": "^7.2",
        "guzzlehttp/psr7": "^2.1",
        "intervention/image": "^3.0",
        "intervention/image-laravel": "^1.5",
        "laravel/cashier": "^15.0",
        "laravel/framework": "^12.0",
        "laravel/passport": "^12.0",
        "laravel/socialite": "^5.0",
        "laravel/ui": "^4.0",
        "laravolt/avatar": "^6.0",
        "league/flysystem-aws-s3-v3": "^3.0",
        "mariuzzo/laravel-js-localization": "^2.0",
        "matriphe/iso-639": "^2.0",
        "moneyphp/money": "^4.7",
        "monicahq/laravel-cloudflare": "^4.0",
        "monicahq/laravel-sabre": "^1.2",
        "ok/ipstack-client": "^2.0",
        "phar-io/version": "^3.1",
        "pragmarx/google2fa": "^8.0",
        "pragmarx/google2fa-laravel": "^2.3",
        "pragmarx/random": "^0",
        "predis/predis": "^2.0",
        "rinvex/countries": "^9.0",
        "sabre/dav": "^4.0",
        "sentry/sentry-laravel": "^4.15",
        "spatie/laravel-ignition": "^2.0",
        "spatie/macroable": "^2.0",
        "stevebauman/location": "^7.6",
        "symfony/http-client": "^7.0",
        "symfony/mailgun-mailer": "^7.3",
        "thecodingmachine/safe": "^3.0",
        "vectorface/whip": "^0.5",
        "vinkla/hashids": "^13.0",
        "vluzrmos/language-detector": "^2.2",
        "web-token/jwt-library": "^4.0",
        "xantios/mimey": "^2.0",
        "ext-fileinfo": "*"
    },
    "require-dev": {
        "ext-mbstring": "*",
        "barryvdh/laravel-debugbar": "^3",
        "fakerphp/faker": "^1.10",
        "khanamiryan/qrcode-detector-decoder": "^2.0",
        "larastan/larastan": "^3.0",
        "laravel/dusk": "^8.0",
        "laravel/legacy-factories": "^1.0",
        "laravel/sail": "^1.44",
        "laravel/tinker": "^2.6",
        "mockery/mockery": "^1.0",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpcov": "^11.0",
        "phpunit/phpunit": "^12.3",
        "psalm/plugin-laravel": "^3.0",
        "ryoluo/sail-ssl": "^1.4",
        "thecodingmachine/phpstan-safe-rule": "^1.0",
        "vimeo/psalm": "^6.0"
    },
    "suggest": {
        "ext-apcu": "*"
    },
    "config": {
        "apcu-autoloader": true,
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "php-http/discovery": true
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "classmap": [
            "database/seeds",
            "database/factories"
        ],
        "files": [
            "app/Helpers/helpers.php"
        ]
    },
    "autoload-dev": {
        "classmap": [
            "tests/TestCase.php"
        ],
        "psr-4": {
            "Tests\\": "tests/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "scripts": {
        "pre-install-cmd": [
            "App\\Helpers\\ComposerScripts::preInstall"
        ],
        "post-install-cmd": [
            "Illuminate\\Foundation\\ComposerScripts::postInstall"
        ],
        "pre-update-cmd": [
            "App\\Helpers\\ComposerScripts::preUpdate"
        ],
        "post-update-cmd": [
            "Illuminate\\Foundation\\ComposerScripts::postUpdate"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate"
        ]
    }
}
